@model List<ILOps_Inventory.Areas.Inventory.Models.CostEntry>
@{
    ViewData["Title"] = "Inventory Types";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .loading {
        animation: spin 1s linear infinite;
    }
    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .simple-form {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        border-left: 4px solid #28a745;
    }

    .type-badge {
        font-size: 0.85em;
    }

    .is-invalid {
        border-color: #dc3545 !important;
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25) !important;
        background-image: none !important;
    }

    .validation-message {
        color: #dc3545;
        font-size: 0.875em;
        margin-top: 0.25rem;
        display: none;
        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    .is-invalid ~ .validation-message {
        display: block !important;
    }

    .validation-success {
        border-color: #198754 !important;
        box-shadow: 0 0 0 0.2rem rgba(25, 135, 84, 0.25) !important;
    }


    .table,
    .table > :not(caption) > * > * {
        background-color: transparent !important;
        box-shadow: none !important;
        color: inherit !important;
    }
</style>

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <h2><i class="fas fa-boxes"></i> Inventory Types</h2>

            <!-- RADIOS + SIMPLE ADD FORM -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <h3>Select Inventory type</h3>
                    <div class="btn-group w-100" role="group">
                        <input type="radio" class="btn-check" name="type" id="hcc" value="HCC" checked>
                        <label class="btn btn-outline-primary active-type" for="hcc">
                            <i class="fas fa-server me-1"></i>Hardware (HCC)
                        </label>
                        <input type="radio" class="btn-check" name="type" id="acc" value="ACC">
                        <label class="btn btn-outline-success" for="acc">
                            <i class="fas fa-plug me-1"></i>Accessory (ACC)
                        </label>
                        <input type="radio" class="btn-check" name="type" id="oth" value="LIC">
                        <label class="btn btn-outline-warning" for="oth">
                            <i class="fas fa-key me-1"></i>License (LIC)
                        </label>
                    </div>
                </div>
                <div class="col-md-8">
                    <!-- SIMPLIFIED ADD FORM - Only Name + Current Type Display -->
                    <form id="addForm" class="row g-2 simple-form">
                        <input type="hidden" id="addType" value="HCC">
                        <div class="col-md-7 position-relative">
                            <input type="text" class="form-control" id="name" placeholder="Enter Item name ..." required maxlength="100">
                            <div id="nameError" class="validation-message">
                                <i class="fas fa-exclamation-circle me-1"></i>Name is required!
                            </div>
                        </div>
                        @* <div class="col-md-3 d-flex align-items-center">
                            <span id="currentType" class="badge bg-primary type-badge fs-6 px-3 py-2">HCC Selected</span>
                        </div> *@
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-success w-100 h-100" id="submitBtn">
                                <i class="fas fa-plus"></i> Add
                            </button>
                        </div>
                    </form>
                    
                </div>
            </div>

            <!-- STATUS -->
            <div id="status" class="alert alert-info mb-3 d-flex align-items-center">
                <i class="fas fa-info-circle me-2"></i>
                <span>Select type → See filtered names + Add new!</span>
            </div>

            <!-- GRID -->
            <div id="gridContainer" class="card shadow">
                <div class="card-header bg-gradient-primary text-white d-flex justify-content-between align-items-center">
                    <h5 id="gridTitle" class="mb-0">
                        <i class="fas fa-list me-2"></i>HCC Names
                    </h5>
                    <span id="recordCount" class="badge bg-light text-dark fs-6">0 records</span>
                </div>
                <div class="card-body p-0">
                    <div class="p-5 text-center text-muted empty-state">
                        <i class="fas fa-database fa-3x mb-3 opacity-75"></i>
                        <h6 class="mb-1">No data yet</h6>
                        <p class="mb-0">Select type above to load names</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add this MODAL before closing </div> tag (after gridContainer) -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="editModalLabel">Edit Name</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editForm">
                <div class="modal-body">
                    <input type="hidden" id="editId" value="">
                    <div class="mb-3">
                        <label class="form-label fw-bold">New Name</label>
                        <input type="text" class="form-control" id="editName" maxlength="100" required>
                        <div class="form-text">Press Enter or click Save</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning" id="editSaveBtn">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>

        $(document).ajaxStart(function () {
        Spinner.show();
    });

    $(document).ajaxStop(function () {
        Spinner.hide();
    });

    $(document).ajaxError(function () {
        Spinner.hide();
    });


    let currentType = 'HCC';
    let currentPage = 1;
    let pageSize = 10;

    $(function () {
        loadGrid(currentType, 1);

        $('input[name="type"]').change(function () {
            currentType = $(this).val();
            loadGrid(currentType, 1);
        });
    });

    function loadGrid(type, page) {
        currentPage = page;

        $.get('/Inventory/InventoryType/GetData', {
            entryType: type,
            page: page,
            pageSize: pageSize
        })
        .done(res => {
            renderGrid(res.data, type);
            renderPagination(res.totalCount);
            $('#recordCount').text(res.totalCount + ' records');
        });
    }

    function renderGrid(data, type) {
        let rows = data.length ? data.map((x, i) => `
            <tr data-id="${x.id}">
                <td>${(currentPage - 1) * pageSize + i + 1}</td>
                <td>${x.name}</td>
                <td><span class="badge bg-primary">${type}</span></td>
                <td class="text-center">
                    <button class="btn btn-sm btn-warning edit-btn">
                        <i class="fas fa-edit"></i>
                    </button>
                </td>
            </tr>
        `).join('') : `
            <tr><td colspan="4" class="text-center">No records</td></tr>
        `;

        $('#gridContainer .card-body').html(`
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
            </table>
        `);
    }

    function renderPagination(total) {
        let totalPages = Math.ceil(total / pageSize);
        if (totalPages <= 1) return;

        let html = `<nav class="mt-3"><ul class="pagination justify-content-center">`;

        html += `
            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="loadGrid('${currentType}', ${currentPage - 1})">Prev</a>
            </li>`;

        for (let i = 1; i <= totalPages; i++) {
            html += `
            <li class="page-item ${i === currentPage ? 'active' : ''}">
                <a class="page-link" href="#" onclick="loadGrid('${currentType}', ${i})">${i}</a>
            </li>`;
        }

        html += `
            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" href="#" onclick="loadGrid('${currentType}', ${currentPage + 1})">Next</a>
            </li>`;

        html += `</ul></nav>`;

        $('#pagination').remove();
        $('#gridContainer').after(`<div id="pagination">${html}</div>`);
    }
</script>
