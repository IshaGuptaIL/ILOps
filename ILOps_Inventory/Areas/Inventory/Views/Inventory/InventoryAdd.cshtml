@model ILOps_Inventory.Areas.Inventory.Models.InventoryItems
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json

@{
    ViewData["Title"] = "Add Inventory Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card border-0 shadow-lg rounded-3">
                <div class="card-header bg-primary text-white py-3 rounded-top-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="h4 mb-1 fw-bold">Add Inventory Item</h2>
                            <p class="mb-0 opacity-90">Create new item using Iron-Logic fields.</p>
                        </div>
                        <span class="badge bg-light text-primary px-3 py-2 fw-semibold">Inventory</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form id="inventoryForm" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Warehouse -->
                        <div class="mb-4">
                            <label for="Whse" class="form-label fw-semibold">Warehouse <span class="text-danger">*</span></label>
                            <select id="Whse" name="Whse" class="form-select form-select-lg">
                                <option value="">Select Warehouse</option>
                                @foreach (var wh in Model?.Warehouses ?? new())
                                {
                                    <option value="@wh.Value">@wh.Text</option>
                                }
                            </select>
                            <div id="WhseError" class="validation-message"></div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6 position-relative">
                                <label for="PartNo" class="form-label fw-semibold">Part Number <span class="text-danger">*</span></label>
                                <input id="PartNo" name="PartNo" class="form-control form-control-lg" maxlength="50" />
                                <div id="PartNoError" class="validation-message"></div>
                            </div>
                            <div class="col-md-6 position-relative">
                                <label for="ProductCode" class="form-label fw-semibold">Product Code</label>
                                <input id="ProductCode" name="ProductCode" class="form-control form-control-lg" />
                                <div id="ProductCodeError" class="validation-message"></div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6 position-relative">
                                <label for="Description" class="form-label fw-semibold">Description (EN) <span class="text-danger">*</span></label>
                                <input id="Description" name="Description" class="form-control form-control-lg" maxlength="80" />
                                <div id="DescriptionError" class="validation-message"></div>
                            </div>
                            <div class="col-md-6 position-relative">
                                <label for="FrDescription" class="form-label fw-semibold">French Description <span class="text-danger">*</span></label>
                                <input id="FrDescription" name="FrDescription" class="form-control form-control-lg" maxlength="80" />
                                <div id="FrDescriptionError" class="validation-message"></div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-4 position-relative">
                                <label for="Type" class="form-label fw-semibold">Type <span class="text-danger">*</span></label>
                                <select id="Type" name="Type" class="form-select form-control-lg">
                                    <option value="">Select Type</option>
                                    <option value="Hardware">Hardware</option>
                                    <option value="Accessory">Accessory</option>
                                </select>
                                <div id="TypeError" class="validation-message"></div>
                            </div>
                            <div class="col-md-8 position-relative">
                                <label for="AccessoryGroup" class="form-label fw-semibold">Manufacturer</label>
                                <select id="AccessoryGroup" name="AccessoryGroup" class="form-select form-control-lg">
                                    <option value="">-- Select Manufacturer --</option>
                                </select>
                                <div id="AccessoryGroupError" class="validation-message"></div>
                            </div>
                        </div>

                        <div class="row g-4 mb-5">
                            <div class="col-md-3 position-relative">
                                <label for="SalesDept" class="form-label fw-semibold">Sales Dept</label>
                                <input id="SalesDept" name="SalesDept" class="form-control form-control-lg" />
                                <div id="SalesDeptError" class="validation-message"></div>
                            </div>
                            <div class="col-md-4 position-relative">
                                <label for="CostPrice" class="form-label fw-semibold">Cost Price <span class="text-danger">*</span></label>
                                <input id="CostPrice" name="CostPrice" class="form-control form-control-lg" type="number" step="0.01" min="0.01" />
                                <div id="CostPriceError" class="validation-message"></div>
                            </div>
                            <div class="col-md-4 position-relative">
                                <label for="SellingPrice" class="form-label fw-semibold">Selling Price <span class="text-danger">*</span></label>
                                <input id="SellingPrice" name="SellingPrice" class="form-control form-control-lg" type="number" step="0.01" min="0.01" />
                                <div id="SellingPriceError" class="validation-message"></div>
                            </div>
                        </div>

                        <div class="d-flex gap-3 justify-content-end">
                            <a asp-action="InventoryCount" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-arrow-left me-2"></i>Back
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-5" id="submitBtn">
                                <i class="fas fa-plus-circle me-2"></i>Add Item
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

@section Scripts {
    <script>
                   $(document).ajaxStart(function () {
                Spinner.show();
            });

            $(document).ajaxStop(function () {
                Spinner.hide();
            });

            $(document).ajaxError(function () {
                Spinner.hide();
            });


        $(function() {
            console.log('🚀 Full InventoryAdd JS loaded');

            const allManufacturers = @Html.Raw(JsonSerializer.Serialize(Model.Manufacturers));

            const productMap = {
                "ACC": { type: "Accessory", group: "tb1man", salesDept: "5" },
                "HCC": { type: "Hardware", group: "HCC", salesDept: "4" }
            };

                    toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: 1500
        };

            // --- PartNo uppercase ---
            $('#PartNo').on('input', function() {
                $(this).val($(this).val().toUpperCase());
            });

            // --- Filter AccessoryGroup dropdown ---
            function filterAccessoryGroup(code) {
                const $dropdown = $('#AccessoryGroup');
                $dropdown.empty().append('<option value="">-- Select Manufacturer --</option>');

                let filtered = [];
                if(code === 'HCC') filtered = allManufacturers.filter(m => m.InventoryType === 'HCC');
                else if(code === 'ACC') filtered = allManufacturers.filter(m => m.InventoryType === 'ACC');
                else filtered = allManufacturers.filter(m => m.InventoryType === 'OTH');

                filtered.forEach(m => $dropdown.append(`<option value="${m.Name}">${m.Name}</option>`));

                // Optional default
                if(code === 'ACC') $dropdown.val('tb1man');
                if(code === 'HCC') $dropdown.val('HCC');
            }

            // --- Type change ---
            $('#Type').on('change', function() {
                const type = $(this).val();
                if (type === 'Hardware') {
                    $('#ProductCode').val('HCC');
                    $('#SalesDept').val('4');
                    filterAccessoryGroup('HCC');
                } else if (type === 'Accessory') {
                    $('#ProductCode').val('ACC');
                    $('#SalesDept').val('5');
                    filterAccessoryGroup('ACC');
                } else {
                    $('#ProductCode, #SalesDept, #AccessoryGroup').val('');
                    filterAccessoryGroup('OTH');
                }
            });

            // --- ProductCode change ---
            $('#ProductCode').on('input', function() {
                const code = $(this).val().toUpperCase();
                $(this).val(code);

                if(productMap[code]) {
                    const mapping = productMap[code];
                    $('#Type').val(mapping.type).trigger('change');
                    $('#SalesDept').val(mapping.salesDept);
                    filterAccessoryGroup(code);
                }
            });

            // --- Blur validation ---
            $('input, select').on('blur change', validateField);

            // --- Form submit ---
            $('#inventoryForm').submit(async function(e) {
                e.preventDefault();
                clearErrors();
                validateAllFields();

                       // ⛔ STOP submit if PartNo duplicate
        if ($('#PartNo').hasClass('is-invalid')) return;
                if(isFormValid()) submitForm();
            });


            let partNoTimer = null;
                    $('#PartNo').on('blur', function () {
            const partNo = $(this).val().trim();
            const whse = $('#Whse').val();

            if (!partNo || !whse) return;

            clearTimeout(partNoTimer);
            partNoTimer = setTimeout(() => {
                $.get('@Url.Action("CheckPartNo", "Inventory", new { area = "Inventory" })',
                    { partNo: partNo, whse: whse },
                    function (res) {
                        if (res.exists) {
                            $('#PartNo')
                                .addClass('is-invalid');
                            $('#PartNoError')
                                .text('Part Number already exists in this warehouse')
                                .show();
                        }
                        else {
        $('#PartNo')
            .removeClass('is-invalid');
        $('#PartNoError')
            .hide()
            .empty();
    }
                    });
            }, 300);
        });

            function validateField() {
                const $field = $(this);
                const value = $field.val()?.trim();
                const id = $field.attr('id');
                const $error = $('#' + id + 'Error');

                $field.removeClass('is-invalid');
                $error.hide().empty();

                let valid = true;
                const name = $field.attr('name');

                if(['Whse','PartNo','Description','FrDescription','Type'].includes(name))
                    valid = !!value;
                else if(['CostPrice','SellingPrice'].includes(name))
                    valid = parseFloat(value) > 0;

                if(!valid) {
                    $field.addClass('is-invalid');
                    $error.html(`<i class="fas fa-exclamation-circle me-1"></i>${getErrorText(name)}`).show();
                }
            }

            function getErrorText(name){
                const errors = {
                    'Whse':'Warehouse required',
                    'PartNo':'Part Number required',
                    'Description':'Description required',
                    'FrDescription':'French description required',
                    'Type':'Type required',
                    'CostPrice':'Cost > 0',
                    'SellingPrice':'Selling > 0'
                };
                return errors[name]||'Required';
            }

            function validateAllFields(){ $('input, select').trigger('blur'); }
            function isFormValid(){ return $('.is-invalid').length===0; }
            function clearErrors(){ $('.is-invalid').removeClass('is-invalid'); $('.validation-message').hide().empty(); }

            async function submitForm(){
                const $btn = $('#submitBtn');
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');
                const formData = new FormData($('#inventoryForm')[0]);

                try{
                    const response = await fetch('@Url.Action("InventoryAdd", "Inventory", new { area = "Inventory" })',{
                        method:'POST',
                        body: formData
                    });
                    const result = await response.json();
                    if(result.success){
                             toastr.success(result.message || 'Inventory item added successfully');

        setTimeout(() => {
            location.reload();
        }, 1500);
                    
                    }
                    else { showServerErrors(result.errors); }
                }catch(e){ console.error(e); }
                finally { $btn.prop('disabled', false).html('<i class="fas fa-plus-circle me-2"></i>Add Item'); }
            }

            function showServerErrors(errors){
                clearErrors();
                Object.entries(errors).forEach(([key,msg])=>{
                    if(key && msg){
                        const $field = $(`[name="${key}"]`);
                        $field.addClass('is-invalid');
                        $(`#${key}Error`).text(msg).show();
                    }
                });
            }
        });
    </script>

    <style>
        /* KILL YELLOW/BROWSER VALIDATION */
        form[novalidate] input:invalid, form[novalidate] select:invalid {
            box-shadow: none !important;
        }

        .invalid-feedback, .valid-feedback, .is-invalid::after, .is-invalid::before, input:invalid ~ .invalid-feedback {
            display: none !important;
        }

        input:invalid, select:invalid {
            box-shadow: none !important;
        }

        #statusMessage, .toast, .popover, .alert-warning, [class*="alert-warning"], .alert-orange {
            display: none !important;
        }

        .validation-message {
            color: #dc3545 !important;
            font-size: .875em;
            margin-top: .25rem;
            display: none;
            animation: shake 0.4s;
        }
        @@keyframes shake {
            0%, 100% {
                transform: translateX(0);
            }

            25% {
                transform: translateX(-4px);
            }

            75% {
                transform: translateX(4px);
            }
        }

        .is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220,53,69,0.25) !important;
        }

            .is-invalid:focus {
                border-color: #dc3545 !important;
                box-shadow: 0 0 0 0.2rem rgba(220,53,69,0.25) !important;
            }
    </style>
}
