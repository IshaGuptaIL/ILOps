@model ILOps_Inventory.Areas.Common.Models.UserIndexViewModel
@{
    ViewData["Title"] = "Users Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-8">
            <h4 class="mb-0"><i class="fa fa-users me-2"></i>Users Management</h4>
        </div>
        <div class="col-4 text-end">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userModal"
                    onclick="loadUserModal(0)">
                <i class="fa fa-plus me-1"></i>Add New User
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>State</th>
                            <th>Zip Code</th>
                            <th>Country</th>
                            <th>City</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int srNo = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        }
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@srNo</td>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.ContactNumber</td>
                                <td>@user.Address</td>
                                <td>@user.State</td>
                                <td>@user.ZipCode</td>
                                <td>@user.Country</td>
                                <td>@user.City</td>
                                <td>@user.RoleName</td>
                                <td>
                                    <span class="badge @(user.IsActive ? "bg-success" : "bg-danger")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>@user.CreatedDate.ToString("dd-MM-yy")</td>
                                <td>
                                    <button class="btn btn-sm btn-warning me-1" onclick="loadUserModal(@user.Id)">
                                        <i class="fa fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteUser(@user.Id)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                            srNo++;
                        }
                    </tbody>
                </table>
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            Showing @(Math.Min((Model.CurrentPage - 1) * Model.PageSize + 1, Model.TotalUsers))
                            to @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalUsers))
                            of @Model.TotalUsers users
                        </div>

                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                <!-- Previous -->
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="/Common/User/Index?page=@(Model.CurrentPage - 1)&pageSize=@Model.PageSize">
                                        <i class="fa fa-chevron-left"></i>
                                    </a>
                                </li>

                                <!-- Numbers -->
                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="/Common/User/Index?page=@i&pageSize=@Model.PageSize">@i</a>
                                    </li>
                                }

                                <!-- Next -->
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="/Common/User/Index?page=@(Model.CurrentPage + 1)&pageSize=@Model.PageSize">
                                        <i class="fa fa-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- User Modal -->
<div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Add New User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="userForm">
                <div class="modal-body">
                    <input type="hidden" id="UserId" name="Id" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="FullName" name="FullName" required />
                            <span class="text-danger" id="FullName-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="Email" name="Email" required />
                            <span class="text-danger" id="Email-error"></span>
                        </div>
                    </div>

                    <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="PhoneNumber" name="ContactNumber" />
                                <span class="text-danger" id="ContactNumber-error"></span>  <!-- ✅ CHANGED: name & id-error -->
                            </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Password</label>
                            <input type="password" class="form-control" id="Password" name="Password" />
                            <div class="form-text">Leave blank for Edit (no password change)</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Role <span class="text-danger">*</span></label>
                            <select class="form-select" id="UserRoleId" name="UserRoleId" required>
                                <option value="">Select Role</option>
                                @foreach (var role in Model.Roles)
                                {
                                    <option value="@role.Id">@role.Name</option>
                                }
                            </select>
                            <span class="text-danger" id="UserRoleId-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Address</label>
                            <input type="text" class="form-control" id="Address" name="Address" />
                            <span class="text-danger" id="Address-error"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">City</label>
                            <input type="text" class="form-control" id="City" name="City" />
                            <span class="text-danger" id="City-error"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="form-label">State</label>
                            <input type="text" class="form-control" id="State" name="State" />
                            <span class="text-danger" id="State-error"></span>
                        </div>
                      
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Zip Code</label>
                            <input type="text" class="form-control" id="ZipCode" name="ZipCode" />
                            <span class="text-danger" id="ZipCode-error"></span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="form-label">Country</label>
                            <input type="text" class="form-control" id="Country" name="Country" />
                            <span class="text-danger" id="Country-error"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" />
                            <label class="form-check-label fw-bold">Active User</label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save me-1"></i>Save User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let currentUserId = 0;

        function showError(field, message) {
            const errorEl = document.getElementById(field + '-error');
            if (errorEl) errorEl.textContent = message;
        }

        function clearErrors() {
            document.querySelectorAll('[id$="-error"]').forEach(el => el.textContent = '');
            document.getElementById('userForm').classList.remove('was-validated');
        }

        async function loadUserModal(userId) {
            currentUserId = userId;
            const modal = new bootstrap.Modal(document.getElementById('userModal'));
            clearErrors();
            document.getElementById('userForm').reset();

            if (userId === 0) {
                // ✅ ADD NEW
                document.getElementById('modalTitle').textContent = 'Add New User';
                document.getElementById('UserId').value = '0';
                document.getElementById('Password').required = true;
                document.getElementById('Password').placeholder = 'Enter password';
                document.getElementById('IsActive').checked = false;  // ✅ Default ACTIVE
            } else {
                // ✅ EDIT
                document.getElementById('modalTitle').textContent = 'Edit User';
                document.getElementById('Password').required = false;
                document.getElementById('Password').placeholder = 'Leave blank to keep current';

                try {
                    const response = await fetch(`/Common/User/GetUserById?id=${userId}`);
                    const user = await response.json();

                    if (user) {
                        document.getElementById('UserId').value = user.id || 0;
                        document.getElementById('FullName').value = user.fullName || '';
                        document.getElementById('Email').value = user.email || '';
                        document.getElementById('PhoneNumber').value = user.contactNumber || '';  // ✅ FIXED: contactNumber
                        document.getElementById('Address').value = user.address || '';
                        document.getElementById('State').value = user.state || '';
                        document.getElementById('ZipCode').value = user.zipCode || '';
                        document.getElementById('Country').value = user.country || '';
                        document.getElementById('City').value = user.city || '';
                        document.getElementById('UserRoleId').value = user.userRoleId || '';
                        document.getElementById('IsActive').checked = !!user.isActive;  // ✅ Boolean fix
                    }
                } catch (error) {
                    console.error('Load error:', error);
                    alert('Error loading user data');
                }
            }
            modal.show();
        }

        async function deleteUser(userId) {
            if (!confirm('Deactivate this user and remove permissions?')) return;

            try {
                const response = await fetch(`/Common/User/Delete/${userId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });
                const result = await response.json();

                if (result.success) {
                    location.reload();  // ✅ Reload with pagination preserved
                } else {
                    alert('Error: ' + (result.message || 'Unknown error'));
                }
            } catch (error) {
                alert('Delete failed');
            }
        }

        document.getElementById('userForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            clearErrors();

            // ✅ Client validation
            const roleId = document.getElementById('UserRoleId').value;
            if (!roleId || roleId === '0') {
                showError('UserRoleId', 'Please select a role');
                return;
            }

            const formData = new FormData(e.target);
            // ✅ FIX: IsActive checkbox handling
            formData.set('IsActive', document.getElementById('IsActive').checked.toString());

            const url = currentUserId === 0 ? '/Common/User/Create' : '/Common/User/Update';

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    body: formData
                });
                const result = await response.json();

                if (!result.success) {
                    if (result.errors) {
                        Object.entries(result.errors).forEach(([key, msg]) => {
                            showError(key, msg);
                        });
                    } else {
                        alert('Error: ' + (result.message || 'Unknown error'));
                    }
                } else {
                    // ✅ Success: Close modal + reload (pagination safe)
                    const modalEl = document.getElementById('userModal');
                    const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modalInstance.hide();
                    setTimeout(() => location.reload(), 300);
                }
            } catch (error) {
                alert('Save failed');
            }
        });
    </script>

}
