<style>
    .spinner-overlay {
        position: fixed;
        inset: 0;
        background: radial-gradient(circle at center, rgba(20,20,40,.75), rgba(5,5,15,.9));
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity .4s ease;
    }

        .spinner-overlay.active {
            opacity: 1;
            pointer-events: all;
        }

    .spinner-card {
        position: relative;
        width: 130px;
        height: 130px;
        border-radius: 50%;
        background: rgba(255,255,255,.05);
        box-shadow: 0 0 40px rgba(106,227,255,.35), inset 0 0 30px rgba(255,255,255,.08);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Outer rotating ring */
    .spinner-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 4px solid transparent;
        border-top-color: #6ae3ff;
        border-right-color: #9b8cff;
        animation: spin 1.6s linear infinite;
    }

    /* Inner pulsing core */
    .spinner-core {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6ae3ff, #9b8cff);
        box-shadow: 0 0 25px rgba(155,140,255,.8);
        animation: pulse 1.8s ease-in-out infinite;
    }

    .spinner-text {
        position: absolute;
        bottom: -38px;
        font-size: 13px;
        letter-spacing: 2px;
        color: #dcefff;
        text-transform: uppercase;
    }

    /* Animations */
    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: .9;
        }

        50% {
            transform: scale(1.4);
            opacity: .4;
        }
    }
</style>

<div id="global-spinner" class="spinner-overlay">
    <div class="spinner-card">
        <div class="spinner-ring"></div>
        <div class="spinner-core"></div>
        <div class="spinner-text">Loading</div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
<script>
    (function (window) {

        window.Spinner = {
            show() {
                document.getElementById("global-spinner")
                    ?.classList.add("active");
            },
            hide() {
                document.getElementById("global-spinner")
                    ?.classList.remove("active");
            }
        };

    })(window);
</script>

<script>
    $(document).ready(function() {
        $('.side-menu a').on('click', function(e) {
            Spinner.show();

           
        });
    });
</script>