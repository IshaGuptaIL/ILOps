<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ILOps Inventory</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
    <style>
        .main-content {
            margin-left: 0px !important;
        }
    </style>
</head>
<body class="d-flex min-vh-100 flex-column">
    @{
        var isLoggedIn = Context.Session.GetString("IsLoggedIn") == "true";
        var userEmail = Context.Session.GetString("UserEmail") ?? "User";
    }

    @if (isLoggedIn)
    {
        <div class="d-flex flex-nowrap min-vh-100">
            <!-- Sidebar -->
            <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-gradient shadow-lg d-flex flex-column vh-100 sticky-top overflow-auto">
                <div class="sidebar-header p-4 text-white text-center border-bottom flex-shrink-0">
                    <h4 class="mb-0">
                        <i class="fas fa-box-open me-2"></i>ILOps Inventory
                    </h4>
                </div>

                <div class="sidebar-nav p-3 flex-grow-1">
                    <ul id="sidebar-menu" class="nav flex-column"></ul>
                </div>

                <div class="sidebar-footer mt-auto p-3 flex-shrink-0">
                    <a href="@Url.Action("Logout", "Home", new { area = "Common" })" class="btn btn-danger w-100">
                        <i class="fas fa-sign-out-alt me-2"></i>Logout (@userEmail)
                    </a>
                </div>
            </div>

            <!-- Main Content -->
            <div class="flex-grow-1">
                <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top z-1">
                    <div class="container-fluid">
                        <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-brand fw-bold text-primary ms-3">
                            @ViewData["Title"]
                        </div>
                    </div>
                </nav>

                <main class="main-content p-4 overflow-auto" style="padding: 68px !important;height: calc(100vh - 56px);">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="min-vh-100 d-flex align-items-center justify-content-center bg-gradient">
            @RenderBody()
        </div>
    }
    @Html.Partial("_Spinner")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var isLoggedIn = '@(isLoggedIn ? "true" : "false")';
            if (isLoggedIn === 'true') {
                loadSidebarMenus();
            }
        });

        function loadSidebarMenus() {
            fetch('@Url.Action("GetUserMenuPermissions", "RolePermission", new { area = "Common" })')
                .then(r => r.json())
                .then(buildSidebarFromMenus)
                .catch(err => console.error('Sidebar load error', err));
        }

        function buildSidebarFromMenus(menus) {
            const root = document.getElementById('sidebar-menu');
            if (!root) return;

            root.innerHTML = '';

            const byParent = {};
            menus.forEach(m => {
                const pid = m.parentId || 0;
                if (!byParent[pid]) byParent[pid] = [];
                byParent[pid].push(m);
            });

            function buildList(parentId) {
                const ul = document.createElement('ul');
                ul.className = parentId === 0 ? 'nav flex-column' : 'nav flex-column ms-3';

                (byParent[parentId] || []).forEach(m => {
                    const li = document.createElement('li');
                    li.className = 'nav-item';

                    const a = document.createElement('a');
                    a.className = 'nav-link text-white';
                    const iconClass = m.icon || 'bi-dot';
                    const controller = m.controller || '';
                    let url = '#';

                    if (controller) {
                        if (controller.startsWith('/')) {
                            url = controller;
                        } else {
                            url = '/' + controller;
                        }
                    }

                    a.href = url;
                    a.innerHTML = `<i class="bi ${iconClass} me-2"></i>${m.menuName}`;
                    li.appendChild(a);

                    if (byParent[m.id] && byParent[m.id].length > 0) {
                        li.appendChild(buildList(m.id));
                    }

                    ul.appendChild(li);
                });

                return ul;
            }

            const tree = buildList(0);
            root.appendChild(tree);
        }
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
